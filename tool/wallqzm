nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;display:flex;align-items:center;gap:22px;height:52px;padding:0 12px;background:var(--nav);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.logo{font-weight:800;font-size:19px;letter-spacing:-.03em;margin-inline-end:auto}
.logo i{font-style:normal;color:var(--acc)}
nav a.l,nav button{color:var(--mute);font:inherit;background:none;border:0;cursor:pointer;padding:6px 2px;transition:color .2s}
nav a.l:hover,nav a.l.on,nav button:hover{color:var(--ink)}
.catmenu{position:relative}
.catmenu .pop{position:absolute;inset-inline-end:0;top:36px;min-width:190px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:6px;display:none;box-shadow:0 12px 40px rgba(0,0,0,.18)}
.catmenu.open .pop{display:block;animation:in .18s ease-out}
.pop a{display:flex;justify-content:space-between;padding:7px 10px;border-radius:6px;color:var(--ink)}
.pop a:hover{background:var(--line)}
.pop span{color:var(--mute)}
#sf{display:flex;align-items:center}
#q{width:0;opacity:0;border:0;border-bottom:1px solid var(--line);background:none;color:var(--ink);font:inherit;padding:4px 0;transition:width .3s,opacity .3s}
#sf.open #q{width:min(200px,38vw);opacity:1;margin-inline-end:6px}
main{padding:0 var(--gap) 40px;animation:in .35s ease-out}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.head{padding:18px 4px 14px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:baseline;justify-content:space-between}
.head h1{margin:0;font-size:clamp(26px,4.4vw,52px);line-height:1;letter-spacing:-.04em;font-weight:800}
.head p{margin:0;color:var(--mute)}
.chips{display:flex;gap:6px;overflow-x:auto;padding:0 4px 12px;scrollbar-width:none}
.chips a{white-space:nowrap;border:1px solid var(--line);border-radius:99px;padding:3px 12px;color:var(--mute);transition:.2s}
.chips a:hover,.chips a.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.mas{display:flex;gap:var(--gap);align-items:flex-start}
.col{flex:1;min-width:0;display:flex;flex-direction:column;gap:var(--gap)}
.tile{position:relative;display:block;overflow:hidden;border-radius:3px;background:var(--line);animation:pop .55s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--i)*35ms)}
@keyframes pop{from{opacity:0;transform:scale(.97) translateY(14px)}to{opacity:1;transform:none}}
.tile img{display:block;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .5s,transform .7s cubic-bezier(.2,.7,.2,1)}
.tile img.ld{opacity:1}
.tile:hover img,.tile:focus-visible img{transform:scale(1.045)}
.ov{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:12px;color:#fff;background:linear-gradient(to top,rgba(5,6,10,.82),rgba(5,6,10,.1) 60%);opacity:0;transition:opacity .3s}
.tile:hover .ov,.tile:focus-visible .ov{opacity:1}
.ov b{font-size:15px;line-height:1.2;letter-spacing:-.01em;transform:translateY(8px);transition:transform .3s}
.ov small{opacity:.75}
.tile:hover .ov b{transform:none}
@media(hover:none){.ov{opacity:1;background:linear-gradient(to top,rgba(5,6,10,.6),transparent 38%)}.ov b{font-size:12px;transform:none}.ov small{display:none}}
.empty{padding:70px 4px;color:var(--mute);font-size:18px}
.empty a{color:var(--acc)}
.det{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:36px;padding:10px 4px 36px;align-items:start;max-width:1400px;margin:0 auto}
.det .pic{position:relative;border-radius:4px;overflow:hidden;background:var(--line);max-height:calc(100vh - 90px);justify-self:center;width:100%}
.det .pic img{display:block;width:100%;height:auto;max-height:calc(100vh - 90px);object-fit:contain}
.info{position:sticky;top:70px}
.info h1{font-size:clamp(28px,3.6vw,46px);line-height:1.02;letter-spacing:-.04em;margin:6px 0 14px;font-weight:800}
.back{color:var(--mute);background:none;border:0;font:inherit;cursor:pointer;padding:0}
.back:hover{color:var(--ink)}
.desc{max-width:60ch;margin:0 0 18px}
dl{margin:0 0 20px;display:grid;grid-template-columns:auto 1fr;gap:8px 18px;border-top:1px solid var(--line);padding-top:14px}
dt{color:var(--mute)}dd{margin:0}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:22px}
.tags a{border:1px solid var(--line);border-radius:99px;padding:2px 11px;color:var(--mute)}
.tags a:hover{color:var(--ink);border-color:var(--ink)}
.cta{display:inline-block;background:var(--acc);color:var(--on);padding:11px 22px;border-radius:99px;font-weight:600;transition:transform .2s}
.cta:hover{transform:translateY(-2px)}
.rel{padding:8px 0 0}
.rel h2{font-size:22px;letter-spacing:-.03em;margin:8px 4px 12px}
footer{padding:20px 12px 30px;color:var(--mute);border-top:1px solid var(--line);margin-top:20px}
@media(max-width:820px){.det{grid-template-columns:1fr;gap:18px}.info{position:static}nav{gap:14px}.hm{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

nav{border-bottom:1px solid var(--line)}
.head{background:var(--bg);margin-top:8px;padding:16px 14px 8px;border-radius:4px 4px 0 0}
.chips{background:var(--bg);padding:0 14px 12px;border-radius:0 0 4px 4px;margin-bottom:8px}
.empty{background:var(--bg);margin-top:8px;padding:40px 18px;border-radius:4px}
.info{background:var(--bg);padding:22px;border-radius:4px}
.rel h2{background:var(--bg);display:inline-block;padding:6px 14px;border-radius:4px;margin:8px 0}
.tile,.det .pic{box-shadow:0 2px 7px rgba(0,0,0,.4)}
footer{background:var(--bg);margin-top:20px;border-top:0}
.logo{font-size:21px;letter-spacing:0}
body *{letter-spacing:0!important}
body{line-height:1.8}
.logo{font-family:"Blaka","Rubik",sans-serif;font-weight:400;font-size:28px;line-height:1.2}
.head h1,.info h1{line-height:1.35}
.rel h2{line-height:1.5}
[href^="mailto"]{direction:ltr;display:inline-block}
html{direction:ltr}
body{direction:rtl}
::-webkit-scrollbar{width:14px;height:14px}
::-webkit-scrollbar-track{background:#140f0d;border-inline-start:1px solid var(--line)}
::-webkit-scrollbar-thumb{background:linear-gradient(#b4482f,#8a2f1f);border:3px solid #140f0d;border-radius:7px;box-shadow:inset 0 1px 0 rgba(255,255,255,.28)}
::-webkit-scrollbar-thumb:hover{background:linear-gradient(var(--acc),#b4482f)}
@supports not selector(::-webkit-scrollbar){html{scrollbar-width:thin;scrollbar-color:#a8432f #140f0d}}
</style>
</head>
<body>
<nav>
  <a class="logo" href="#/">دیوار <i>آجری</i></a>
  <a class="l hm" href="#/" id="nh">خانه</a>
  <div class="catmenu" id="cm"><button id="cb" aria-haspopup="true">دسته‌بندی‌ها</button><div class="pop" id="cp"></div></div>
  <form id="sf"><input id="q" type="search" placeholder="جستجوی پوستر" aria-label="جستجوی پوستر"><button type="button" id="sb" aria-label="جستجو"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></button></form>
  </nav>
<main id="app"></main>
<footer>دیوار آجری — دیواری از پوسترها</footer>

<script id="state" type="application/json">{}</script>
<script id="js">
/* ============ DATA LAYER ============
   Add categories to CATS. Add posters to RAW (or replace loadPosters() with fetch('posters.json')).
   Each poster: id, title, cat, w, h, img (URL; omit to auto-generate a placeholder), tags, desc, date, loc, contact, link. */
const CATS0=["رویدادها","تخفیف‌ها","فروشگاه‌ها","دوره‌ها","کنسرت‌ها","خدمات","تبلیغات","سایر"];
const TD={name:"دیوار آجری",homeTitle:"دیوار",homeSub:"{n} پوستر، تازه‌ترین‌ها اول",home:"خانه",cats:"دسته‌بندی‌ها",all:"همه",searchPh:"جستجوی پوستر",back:"→ بازگشت به دیوار",related:"پوسترهای مرتبط",cta:"مشاهده پیوند",kCat:"دسته",kWhen:"زمان",kWhere:"مکان",kContact:"تماس",empty:"هنوز پوستری اینجا نیست.",noRes:"چیزی برای «{q}» پیدا نشد.",footer:"دیوار آجری — دیواری از پوسترها",accent:"#e8795f",gap:8};
let S;try{S=JSON.parse(document.getElementById("state").textContent)}catch(e){S=null}
if(!S||!S.posters)S={cats:[...CATS0],t:{},posters:[]};S.t=S.t||{};
let CATS,POSTERS,BY,T;
const slug=s=>encodeURIComponent(s),fa=n=>Number(n).toLocaleString("fa-IR"),nz=s=>s.toLowerCase().replace(/ي/g,"ی").replace(/ك/g,"ک");

/* ============ UI ============ */
const $=s=>document.querySelector(s),app=$("#app"),esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let cols=0,cur={items:null,host:null},scrolls={},fresh=true,key="";
const colCount=()=>{const w=innerWidth;return w<560?2:w<900?3:w<1250?4:w<1650?5:6};
try{scrolls=JSON.parse(sessionStorage.getItem("pw")||"{}")}catch(e){}
function tile(p,i){return`<a class="tile" href="#/poster/${p.id}" style="aspect-ratio:${p.w}/${p.h};--i:${Math.min(i,14)}" aria-label="${esc(p.title)}"><img src="${p.thumb}" width="${p.w*100}" height="${p.h*100}" alt="${esc(p.title)}" loading="lazy" decoding="async" onload="this.classList.add('ld')"><div class="ov"><b>${esc(p.title)}</b><small>${esc(p.cat)}</small></div></a>`}
function masonry(host,items){cols=colCount();const hs=Array(cols).fill(0),bins=hs.map(()=>[]);
items.forEach((p,i)=>{let m=hs.indexOf(Math.min(...hs));bins[m].push(tile(p,i));hs[m]+=p.h/p.w});
host.innerHTML=`<div class="mas">${bins.map(b=>`<div class="col">${b.join("")}</div>`).join("")}</div>`;cur={items,host}}
function rank(q){const t=nz(q).split(/\s+/).filter(Boolean);return POSTERS.map(p=>{let s=0;const f=[[p.title,5],[p.cat,4],[p.tags.join(" "),4],[p.desc,2],[p.loc||"",1],[p.date||"",1]];
for(const w of t){let hit=0;f.forEach(([x,v])=>{if(nz(x).includes(w))hit=Math.max(hit,v)});if(!hit)return{p,s:0};s+=hit}return{p,s}}).filter(x=>x.s).sort((a,b)=>b.s-a.s).map(x=>x.p)}
function header(title,sub,active){return`<div class="head"><h1>${title}</h1><p>${sub}</p></div><div class="chips"><a href="#/" class="${active==="all"?"on":""}">${T.all}</a>${CATS.filter(c=>POSTERS.some(p=>p.cat===c)).map(c=>`<a href="#/category/${slug(c)}" class="${active===c?"on":""}">${c}</a>`).join("")}</div>`}
function gallery(title,sub,items,active,empty){app.innerHTML=header(title,sub,active)+(items.length?`<div id="mh"></div>`:`<div class="empty">${empty||T.empty} <a href="#/">بازگشت به همه پوسترها</a></div>`);if(items.length)masonry($("#mh"),items)}
function detail(p){const rel=POSTERS.filter(o=>o.id!==p.id).map(o=>({o,s:(o.cat===p.cat?3:0)+o.tags.filter(t=>p.tags.includes(t)).length*2})).filter(x=>x.s).sort((a,b)=>b.s-a.s).slice(0,10).map(x=>x.o);
const row=(k,v)=>v?`<dt>${k}</dt><dd>${v}</dd>`:"";
const c=p.contact?(p.contact.includes("@")?`<a href="mailto:${esc(p.contact)}">${esc(p.contact)}</a>`:esc(p.contact)):"";
app.innerHTML=`<div class="det"><div class="pic"><img src="${p.img}" width="${p.w*100}" height="${p.h*100}" alt="${esc(p.title)}" decoding="async" style="aspect-ratio:${p.w}/${p.h}"></div>
<div class="info"><button class="back" id="bk">${esc(T.back)}</button><h1>${esc(p.title)}</h1><p class="desc">${esc(p.desc)}</p>
<dl>${row(T.kCat,`<a href="#/category/${slug(p.cat)}">${esc(p.cat)}</a>`)}${row(T.kWhen,esc(p.date||""))}${row(T.kWhere,esc(p.loc||""))}${row(T.kContact,c)}</dl>
<div class="tags">${p.tags.map(t=>`<a href="#/search/${encodeURIComponent(t)}">#${esc(t)}</a>`).join("")}</div>
${p.link?`<a class="cta" href="${esc(p.link)}" target="_blank" rel="noopener">${esc(T.cta)}</a>`:""}</div></div>
${rel.length?`<section class="rel"><h2>${esc(T.related)}</h2><div id="mh"></div></section>`:""}`;
if(rel.length)masonry($("#mh"),rel);$("#bk").onclick=()=>{if(history.length>1&&!fresh0)history.back();else location.hash="#/"}}
let fresh0=true;
function route(){const h=location.hash.replace(/^#\/?/,"").split("/"),k=location.hash||"#/";key=k;
$("#cm").classList.remove("open");app.style.animation="none";app.offsetHeight;app.style.animation="";
const [a,b]=[h[0],decodeURIComponent(h.slice(1).join("/")||"")];
$("#nh").classList.toggle("on",!a);
if(a==="poster"&&BY[b]){detail(BY[b]);document.title=BY[b].title+" — "+T.name}
else if(a==="category"){const c=CATS.find(x=>x===b);const it=POSTERS.filter(p=>p.cat===c);gallery(c||"دسته‌بندی",fa(it.length)+" پوستر",it,c,"هنوز پوستری در این دسته نیست.");document.title=(c||"دسته‌بندی")+" — "+T.name}
else if(a==="search"){const it=b?rank(b):[];gallery(b?`نتایج «${esc(b)}»`:"جستجو",b?fa(it.length)+" پوستر":"عنوان، برچسب، دسته یا مکان را بنویسید.",it,"",b?T.noRes.replace("{q}",esc(b)):"از کادر جستجوی بالا استفاده کنید.");document.title="جستجو — "+T.name}
else{gallery(T.homeTitle,T.homeSub.replace("{n}",fa(POSTERS.length)),POSTERS,"all");document.title=T.name}
const y=!fresh&&scrolls[k]||0;scrollTo(0,y);fresh=true;fresh0=false;
setTimeout(()=>{if(!y)return;scrollTo(0,y)},60)}
addEventListener("hashchange",route);
document.addEventListener("click",e=>{const a=e.target.closest("a[href^='#']");if(a)fresh=true;if(!e.target.closest("#cm"))$("#cm").classList.remove("open")},true);
addEventListener("popstate",()=>{fresh=false});
let st;addEventListener("scroll",()=>{clearTimeout(st);st=setTimeout(()=>{scrolls[key]=scrollY;try{sessionStorage.setItem("pw",JSON.stringify(scrolls))}catch(e){}},120)},{passive:true});
addEventListener("resize",()=>{if(cur.host&&cur.host.isConnected&&colCount()!==cols)masonry(cur.host,cur.items)});
function chrome(){$("#cp").innerHTML=CATS.map(c=>`<a href="#/category/${slug(c)}">${c}<span>${POSTERS.filter(p=>p.cat===c).length||""}</span></a>`).join("");const w=T.name.trim().split(" "),l=w.pop();$(".logo").innerHTML=(w.length?esc(w.join(" "))+" ":"")+"<i>"+esc(l)+"</i>";$("#nh").textContent=T.home;$("#cb").textContent=T.cats;$("#q").placeholder=T.searchPh;$("footer").textContent=T.footer}
$("#cb").onclick=()=>$("#cm").classList.toggle("open");
const sf=$("#sf"),q=$("#q");
$("#sb").onclick=()=>{sf.classList.toggle("open");if(sf.classList.contains("open"))q.focus()};
sf.onsubmit=e=>{e.preventDefault();fresh=true;location.hash="#/search/"+encodeURIComponent(q.value.trim())};
let live;q.oninput=()=>{clearTimeout(live);live=setTimeout(()=>{fresh=true;const v="#/search/"+encodeURIComponent(q.value.trim());if(location.hash.startsWith("#/search"))history.replaceState(null,"",v),route();else location.hash=v},250)};
if("scrollRestoration"in history)history.scrollRestoration="manual";
function lum(h){const n=parseInt(h.slice(1),16);const c=[n>>16,n>>8&255,n&255].map(v=>{v/=255;return v<=.03928?v/12.92:((v+.055)/1.055)**2.4});return .2126*c[0]+.7152*c[1]+.0722*c[2]}
function theme(){const s=document.documentElement.style;s.setProperty("--acc",T.accent);s.setProperty("--on",lum(T.accent)>.4?"#1a110e":"#fff");s.setProperty("--gap",T.gap+"px")}
function apply(){CATS=S.cats;T={...TD,...S.t};POSTERS=S.posters.filter(p=>!p.hidden);BY=Object.fromEntries(POSTERS.map(p=>[p.id,p]));theme();chrome()}

const okd=d=>d&&Array.isArray(d.posters)&&Array.isArray(d.cats);
function useData(d){S={cats:d.cats.map(String),t:d.t||{},posters:d.posters.map(p=>({...p,id:String(p.id),tags:Array.isArray(p.tags)?p.tags:[],desc:p.desc||"",w:+p.w||3,h:+p.h||4,thumb:p.thumb||p.img}))};apply();route()}
function noFile(){apply();app.innerHTML=`<div class="empty"><p><b>فایل site-data.json کنار این صفحه پیدا نشد.</b></p><p>آن را کنار index.html بگذارید و صفحه را با یک وب‌سرور یا GitHub Pages باز کنید. اگر صفحه را مستقیم از روی کامپیوتر باز کرده‌اید، مرورگر خواندن خودکار فایل را اجازه نمی‌دهد؛ فایل را دستی انتخاب کنید.</p><p id="pe"></p><label class="cta">انتخاب فایل site-data.json<input type="file" accept=".json,application/json" id="pf" hidden></label></div>`;
$("#pf").onchange=async e=>{try{const d=JSON.parse(await e.target.files[0].text());if(!okd(d))throw 0;useData(d)}catch(x){$("#pe").textContent="این فایل معتبر نیست: باید فیلدهای cats و posters داشته باشد."}}}
(async()=>{apply();if(S.posters.length)route();else app.innerHTML='<div class="empty">در حال بارگذاری…</div>';
try{const r=await fetch("site-data.json",{cache:"no-store"});if(!r.ok)throw 0;const d=await r.json();if(!okd(d))throw 0;useData(d)}catch(x){if(!S.posters.length)noFile()}})();
</script>


</body></html>
